<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableGameDebugging>false</EnableGameDebugging>
    <!-- Allow environment variable or CLI override -->
    <GamePath Condition="'$(GamePath)' == '' AND '$(STARDEW_GAME_PATH)' != ''">$(STARDEW_GAME_PATH)</GamePath>
  </PropertyGroup>

  <!-- Probe standard registry location if GamePath was not set -->
  <PropertyGroup Condition="'$(GamePath)' == '' AND '$(OS)' == 'Windows_NT'">
    <_SteamGamePath>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 413150', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</_SteamGamePath>
    <GamePath Condition="'$(_SteamGamePath)' != '' AND Exists('$(_SteamGamePath)\Stardew Valley.dll')">$(_SteamGamePath)</GamePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(GamePath)' != '' AND Exists('$(GamePath)\Stardew Valley.dll')">
    <Reference Include="Stardew Valley" HintPath="$(GamePath)\Stardew Valley.dll" />
    <Reference Include="StardewModdingAPI" HintPath="$(GamePath)\StardewModdingAPI.dll" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)\MonoGame.Framework.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UntranslatedStardew.csproj" />
  </ItemGroup>

</Project>
